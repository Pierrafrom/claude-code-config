  },
  "Nouveau chapitre (squelette)": {
    "scope": "latex",
    "prefix": "newchap",
    "body": ["\\chapter{${1:Titre du chapitre}}", "", "$0"],
    "description": "Squelette de nouveau chapitre"
  }
