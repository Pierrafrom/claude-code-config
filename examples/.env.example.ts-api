# Copy to apps/api/.env — never commit the real file. Every variable is validated
# with Zod at startup (fail fast on missing/weak values).

# PostgreSQL connection string
DATABASE_URL=postgres://app:change-me@127.0.0.1:5432/app

# Valkey/Redis (BullMQ store; must run with maxmemory-policy noeviction)
VALKEY_HOST=127.0.0.1
VALKEY_PASSWORD=change-me

# Auth signing secret: >= 32 random characters (generate with the auth library CLI)
BETTER_AUTH_SECRET=
# Public URL of the API
BETTER_AUTH_URL=http://localhost:3000
# Allowed web origin (CORS + trusted origins)
WEB_ORIGIN=http://localhost:8081

# HTTP port
PORT=3000

# Client-side variables are public (bundled in the app): never put secrets here
EXPO_PUBLIC_API_URL=http://localhost:3000
